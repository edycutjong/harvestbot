# ── Deployer (TESTNET ONLY) ──────────────────────────────────────────────────
# Generate a throwaway key: `cast wallet new`. Never use a wallet that holds real funds.
PRIVATE_KEY=0xyour-testnet-private-key-here
DEPLOYER_ADDRESS=0xYourDeployerAddress

# ── Robinhood Chain testnet (chain id 46630) ─────────────────────────────────
# Network details: https://docs.robinhood.com/chain/connecting
# Faucet (0.01 ETH + Stock Tokens / 24 h): https://faucet.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_EXPLORER=https://explorer.testnet.chain.robinhood.com

# ── Arbitrum Sepolia (chain id 421614) — Stylus gas benchmark mirror ─────────
# Faucet: https://www.alchemy.com/faucets/arbitrum-sepolia
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# Optional — contract verification on Arbiscan: https://arbiscan.io/myapikey
# ARBISCAN_API_KEY=your-arbiscan-key
